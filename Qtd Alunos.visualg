algoritmo "Cadastro de Alunos"

var
  nomeAluno: caractere
  qtdAlunos, contador: inteiro
  nomesAlunos: vetor [1..10] de caractere

inicio

  contador <- 1
  escreval("Insira a quantidade de alunos: ")
  leia(qtdAlunos)
  
  para contador de 1 ate qtdAlunos faca
    escreval("Insira o nome do ", contador, "º aluno: ")
    leia(nomeAluno)
    nomesAlunos[contador] <- nomeAluno
  fimpara

  contador <- 1

  para contador de 1 ate 10 faca
    escreval(nomesAlunos[contador])
  fimpara

fimalgoritmo
