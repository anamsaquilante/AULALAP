algoritmo "Funcao Soma"

var
  resultado: inteiro

funcao somar(): inteiro
var
  n1, n2: inteiro
  inicio
    escreval("Digite o primeiro número: ")
    leia(n1)
    escreval("Digite o segundo número: ")
    leia(n2)
    resultado <- n1 + n2
    retorne resultado
fimfuncao

inicio

  somar()
  escreval("A soma é: ", resultado)

fimalgoritmo